# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://localhost:27017/event-collab

# JWT
JWT_ACCESS_SECRET=your-access-secret-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (for CORS & email links)
FRONTEND_URL=http://localhost:5173

# Email (Nodemailer - use Ethereal for dev testing)
EMAIL_HOST=smtp.ethereal.email
EMAIL_PORT=587
EMAIL_USER=your-ethereal-user
EMAIL_PASS=your-ethereal-pass
EMAIL_FROM=noreply@eventcollab.com

# QR / Encryption (optional - for QR payload signing)
QR_SECRET=your-qr-secret-key
